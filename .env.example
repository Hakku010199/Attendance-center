# Supabase configuration (React + Vite RollBeeCall)
# Copy to `.env` and fill in your project values. Never commit real keys.

# --- Frontend-safe (Vite) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SITE_URL=https://rollbeecall.online

# --- Server-side ONLY (Vercel env vars / api/ routes). NEVER add VITE_ prefix. ---
# Resend secret key from https://resend.com/api-keys (re_...)
# RESEND_API_KEY=re_your_key_here
#
# Sender address. Leave commented to use Resend's test sender
# "RollBeeCall <onboarding@resend.dev>" (only delivers to your own
# Resend signup address). After verifying a domain in Resend, set e.g.:
# RESEND_FROM_EMAIL="RollBeeCall <noreply@rollbeecall.online>"
# RESEND_FROM_EMAIL=
